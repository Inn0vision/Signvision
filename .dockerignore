# Root .dockerignore for SignVision

.git/
.github/
.vscode/
.idea/

# Virtual environments & Python cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.log

# Node & Frontend dependencies
node_modules/
Application/node_modules/
Application/.expo/
Application/android/
Application/ios/

# Secrets & Local credentials
.env
.env.*
*.pem
*.key
*.cert
*.crt

# Temporary & Data files
recordings/*
!recordings/.gitkeep
tmp/
temp/
docs/
*.patch
