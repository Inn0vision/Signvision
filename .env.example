# ==============================================================================
# SignVision — Environment Configuration Template
# Copy this file to `.env` in the root directory:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE NLP & LLM CONFIGURATION (Backend: port 8000)
# ------------------------------------------------------------------------------
# Primary Groq API Key for English -> ISL Grammar & Semantic Slot Extraction.
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Recommended Groq model for low latency & high accuracy
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Groq fallback keys for seamless automatic failover if rate limits are hit
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
# Optional: Comma-separated list of additional Groq keys
GROQ_API_KEYS=

# ------------------------------------------------------------------------------
# #### Optional  2. CACHING & DATABASE CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Redis translation cache (defaults to local Redis if available)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_ENABLED=false
REDIS_CACHE_TTL=604800

# ------------------------------------------------------------------------------
# 3. VIDEO MICROSERVICE CONFIGURATION (ML Inference: port 8001)
# ------------------------------------------------------------------------------
# Acceptance threshold for ISL sign recognition (0.0 to 1.0, default 0.50)
SIGN_CONFIDENCE_THRESHOLD=0.50

# Minimum percentage of frames requiring detected hands (0.0 to 1.0, default 0.50)
MIN_HAND_COVERAGE=0.50

# ------------------------------------------------------------------------------
# 4. MOBILE / WEB FRONTEND NETWORKING (Application/)
# ------------------------------------------------------------------------------
# For local web development in browser:
# EXPO_PUBLIC_CORE_API_URL=http://localhost:8000
# EXPO_PUBLIC_VIDEO_API_URL=http://localhost:8001
#
# For physical mobile device / Expo Go over local Wi-Fi:
# Replace 192.168.1.X with your computer's local LAN IP (run `ip a` or `ifconfig`)
EXPO_PUBLIC_CORE_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_VIDEO_API_URL=http://192.168.1.100:8001
