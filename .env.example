# Core Backend AI Keys & Fallbacks
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
GROQ_API_KEYS=
