# ==========================================
# SignVision - Comprehensive .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
project

# Python & Virtual Environments
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.eggs/

# Testing, Coverage & Linters
.pytest_cache/
*/.pytest_cache/
*/**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache
.mypy_cache/
.ruff_cache/

# Databases, Embeddings & Vectors
chroma_db/
*/chroma_db/
*/**/chroma_db/
*.chroma/
*.db
*.sqlite
*.sqlite3

# Audio / Video runtime recordings
recordings/
backend/recordings/
*.mp4
*.webm
*.avi
*.mov
*.wav
*.flac
*.m4a
*.ogg

# Node & Package Managers
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Expo & Web Bundles
.expo/
*/.expo/
.expo-shared/
.metro-cache/
web-build/
Application/dist/

# Android Native Builds
android/.gradle/
android/app/build/
android/build/
Application/android/.gradle/
Application/android/build/
Application/android/app/build/
Application/android/app/.cxx/
Application/android/.kotlin/
*.apk
*.aab

# iOS Native Builds
ios/build/
ios/Pods/
Application/ios/build/
Application/ios/Pods/
*.xcworkspace
*.xcuserdatad

# OS & Editor configurations
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp
.idea/
.vscode/
!.vscode/settings.json
!.vscode/launch.json
.ipynb_checkpoints/
