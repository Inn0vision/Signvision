# ==============================================================================
# SignVision Application — Environment Configuration Template
# Copy this file to `.env` in Application/ or use the root `.env`:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE NLP & LLM CONFIGURATION (Backend: port 8000)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback keys
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
GROQ_API_KEYS=

# ------------------------------------------------------------------------------
# 2. VIDEO MICROSERVICE CONFIGURATION (ML Inference: port 8001)
# ------------------------------------------------------------------------------
SIGN_CONFIDENCE_THRESHOLD=0.50
MIN_HAND_COVERAGE=0.50

# ------------------------------------------------------------------------------
# 3. MOBILE / WEB FRONTEND NETWORKING (Application/)
# ------------------------------------------------------------------------------
# For local web development in browser:
# EXPO_PUBLIC_CORE_API_URL=http://localhost:8000
# EXPO_PUBLIC_VIDEO_API_URL=http://localhost:8001
#
# For physical mobile device / Expo Go over local Wi-Fi:
# Replace 192.168.1.X with your computer's local LAN IP (run `ip a` or `ifconfig`)
EXPO_PUBLIC_CORE_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_VIDEO_API_URL=http://192.168.1.100:8001
