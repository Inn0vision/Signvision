{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CORE_API_URL": "https://signvision.work.gd/core",
        "EXPO_PUBLIC_VIDEO_API_URL": "https://signvision.work.gd/video"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CORE_API_URL": "https://signvision.work.gd/core",
        "EXPO_PUBLIC_VIDEO_API_URL": "https://signvision.work.gd/video"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
